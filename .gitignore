# prisma/ must only ever contain schema.prisma, migrations/, and seed.ts --
# a stray tsc build once emitted compiled output directly into this folder
# (fixed by excluding "prisma" from packages/db/tsconfig.json's include).
# This is a backstop against it happening again silently.
packages/db/prisma/*.js
packages/db/prisma/*.js.map
packages/db/prisma/*.d.ts
packages/db/prisma/*.d.ts.map

# Local Netlify folder
.netlify

# Prisma's engineType="client" generates the client into src/ (so tsconfig's
# rootDir/include naturally picks it up) -- it is build output, never commit it.
packages/db/src/generated/
