# ─────────────────────────────────────────────────────────────────────────────
# Real Estate Sales & Commission Platform — environment
#
# Copy to .env.local (never commit .env.local).
# Every value below is required unless marked OPTIONAL.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local development ────────────────────────────────────────────────────────
# `docker compose up -d` runs Postgres 18 locally (see docker-compose.yml).
# Use this for day-to-day dev and for the concurrency tests in
# docs/06-INVENTORY-SPEC.md -- they need real Postgres, not a mock.
#
#   DATABASE_URL="postgresql://desire:desire_dev_only@localhost:5432/desire"
#   DATABASE_URL_UNPOOLED="postgresql://desire:desire_dev_only@localhost:5432/desire"

# ── Database (Neon, hosted) ──────────────────────────────────────────────────
# POOLED endpoint. Used by the application at runtime. Goes through Neon's
# PgBouncer so serverless function concurrency doesn't exhaust Postgres.
#
# REGION: aws-ap-southeast-1 (Singapore) -- chosen deliberately and pinned
# permanently. A Neon project's region is FIXED at creation; moving later means
# a new project plus a manual dump/restore, so this was decided once, up front,
# rather than optimised for whichever Netlify tier we start on.
#
# KNOWN TRADEOFF: Netlify's FREE tier locks functions to cmh (Ohio), so a
# deployed free-tier page pays a Pacific round trip per query until upgrading to
# Pro (region `sin`, ~$19/mo) -- see docs/21-TIER-LIMITS.md section 2. Not a
# problem in local dev; matters only once this is deployed on the free tier.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/db?sslmode=require"

# DIRECT (unpooled) endpoint. Used ONLY by the Prisma CLI for migrate/db push.
# Wired via `directUrl` in packages/db/prisma/schema.prisma's datasource block
# (verified mechanism since Prisma 4.10 -- NOT prisma.config.ts). Prisma CLI uses
# this automatically for migrate/introspect. Running migrations through the
# pooler is the classic deploy-day failure.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/db?sslmode=require"

# ── Auth (Auth.js) ───────────────────────────────────────────────────────────
AUTH_SECRET=""                        # openssl rand -base64 32
AUTH_URL="http://localhost:3000"      # full public origin in deployed envs
AUTH_TRUST_HOST="true"                # required behind Netlify's proxy

SESSION_IDLE_TIMEOUT_MINUTES="720"    # 12h  — see docs/10-SECURITY.md
SESSION_ABSOLUTE_TIMEOUT_DAYS="7"

# ── Field-level encryption ───────────────────────────────────────────────────
# AES-256-GCM over PAN, Aadhaar and bank details before they reach the database.
# 32 bytes, base64. ROTATING THIS WITHOUT RE-ENCRYPTING MAKES THAT DATA
# UNREADABLE — see docs/10-SECURITY.md before you touch it.
PII_ENCRYPTION_KEY=""
PII_ENCRYPTION_KEY_ID="v1"            # bump on rotation; old key kept for decrypt

# ── Object storage (S3, ap-south-1 Mumbai) ───────────────────────────────────
# Mumbai deliberately: KYC scans and agreements stay India-resident even though
# Neon has no Indian region. See docs/11-COMPLIANCE-INDIA.md.
S3_REGION="ap-south-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PRESIGNED_URL_TTL_SECONDS="300"

# ── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="noreply@example.com"

# ── WhatsApp Business API ────────────────────────────────────────────────────
# Primary notification channel in India. Templates need approval — submit them
# in Phase 2, not Phase 5 (risk R10).
WHATSAPP_PROVIDER=""                  # e.g. gupshup | interakt | meta_cloud
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_SENDER_NUMBER=""

# ── SMS (DLT-registered) ─────────────────────────────────────────────────────
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_ID=""                      # 6 chars, DLT-approved
SMS_DLT_ENTITY_ID=""

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=""                         # OPTIONAL in local
LOG_LEVEL="info"                      # trace|debug|info|warn|error

# ── Jobs ─────────────────────────────────────────────────────────────────────
# Shared secret sent as the x-job-secret header. Job handlers reject any request
# without it, so /api/jobs/* cannot be triggered from the open internet.
#
# Jobs are driven by EXTERNAL cron (.github/workflows/scheduled-jobs.yml), not by
# Netlify Scheduled Functions -- those have been reported to stop firing silently.
# See docs/21-TIER-LIMITS.md section 11.
# Mirror this value into the GitHub repo secret JOB_TRIGGER_SECRET, alongside
# APP_BASE_URL.
JOB_TRIGGER_SECRET=""

# Dead-man's switch thresholds (minutes). /api/health reports each job's last
# successful run; the synthetic monitor pages when one goes stale. An external
# trigger fails by ABSENCE and raises no error, so this is not optional.
JOB_STALE_ALERT_HOLDS_MINUTES="20"
JOB_STALE_ALERT_DAILY_MINUTES="1560"

# ── Business configuration ───────────────────────────────────────────────────
# Defaults only. Per-project values live in the database and override these.
# All PLACEHOLDER — confirm with the client before go-live.
# Inventory board refresh. 60s on Netlify Free (invocation budget), 15s on Pro.
# See docs/21-TIER-LIMITS.md section 1.
INVENTORY_POLL_INTERVAL_SECONDS="60"

DEFAULT_HOLD_TTL_MINUTES="1440"                 # PLACEHOLDER 24h
DEFAULT_HOLD_QUOTA_PER_ASSOCIATE="3"            # PLACEHOLDER
DEFAULT_COMMISSION_MAX_TOTAL_PCT="3.0"          # PLACEHOLDER hard payout ceiling
PAYOUT_RECOVERY_MAX_DEDUCTION_PCT="50"          # PLACEHOLDER cap per cycle
CURRENCY="INR"
TIMEZONE="Asia/Kolkata"

# ── Feature flags (bootstrap only; DB table is authoritative) ────────────────
FEATURE_CUSTOMER_PORTAL="false"
FEATURE_WHATSAPP_NOTIFICATIONS="false"
FEATURE_PAYMENT_GATEWAY="false"
