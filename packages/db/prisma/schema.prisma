// ═══════════════════════════════════════════════════════════════════════════
//  Real Estate Sales & Commission Platform — Prisma schema
//
//  Companion docs:
//    docs/03-DATA-MODEL.md       ERD + entity dictionary
//    docs/04-COMMISSION-SPEC.md  the commission engine
//    docs/05-COLLECTIONS-SPEC.md demands, receipts, alerts
//    docs/06-INVENTORY-SPEC.md   units, holds, price lists
//    docs/19-GLOSSARY.md         READ FIRST. The domain terms are not intuitive.
//
//  Conventions used throughout:
//    · Money is Decimal(18,2). Never Float. Never Int-rupees.
//    · Areas are Decimal(10,2) square feet.
//    · Rates/percentages are Decimal(7,4) — 1.5% is stored as 1.5000.
//    · Every table carries orgId. Single-tenant today; this makes Postgres RLS
//      a later config change rather than a migration.
//    · Financial rows are APPEND-ONLY. No updates. Corrections are contra rows.
//    · Effective-dated assignments use validFrom/validTo (validTo null = current).
//    · Values marked PLACEHOLDER are unconfirmed by the client. Do not ship them.
// ═══════════════════════════════════════════════════════════════════════════

// No Rust query engine binary (GA since Prisma 6.16) -- engineType="client"
// generates a pure TS/WASM client with no native .so/.node file to bundle at
// all, which is what actually ends the class of bug that binaryTargets only
// patched: three real Netlify deploys in a row hit the SAME root cause in
// layers (wrong binary target, then binary present but not copied into the
// serverless bundle by Next.js's file tracer). Runtime connections go through
// a driver adapter instead (see packages/db/src/index.ts) -- @prisma/adapter-pg
// (generic node-postgres), not @prisma/adapter-neon, so the identical code
// path works against local Docker Postgres, CI's ephemeral Postgres, AND
// hosted Neon. Netlify Functions run on normal Node.js, not edge, so there is
// no need for Neon's HTTP-specific transport that adapter-neon exists for.
generator client {
  provider   = "prisma-client"
  engineType = "client"
  output     = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")           // pooled — used by the driver adapter at runtime
  directUrl = env("DATABASE_URL_UNPOOLED")  // direct — Prisma CLI uses this automatically
                                             // for migrate/introspect. Available since
                                             // Prisma 4.10; this is the verified mechanism,
                                             // not prisma.config.ts. See docs/02-ARCHITECTURE.md.
}

