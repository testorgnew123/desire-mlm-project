enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

/// How the associate is engaged. This single field drives the entire tax path:
/// TDS section, GST applicability, and whether payout routes through payroll.
/// See docs/11-COMPLIANCE-INDIA.md.
enum EngagementType {
  EMPLOYEE // incentive = salary -> TDS u/s 192, no GST, via payroll
  CONSULTANT // professional fee -> TDS u/s 194J, GST if registered
  CHANNEL_PARTNER // brokerage      -> TDS u/s 194H, GST if registered
}

enum AssociateStatus {
  ONBOARDING
  ACTIVE
  ON_LEAVE
  NOTICE_PERIOD
  EXITED
  SUSPENDED
}

enum ProjectStatus {
  PLANNING
  PRE_LAUNCH
  LAUNCHED
  SELLING
  SOLD_OUT
  COMPLETED
  ON_HOLD
}

/// Unit lifecycle. Transitions and their guards: docs/06-INVENTORY-SPEC.md.
enum UnitStatus {
  AVAILABLE
  HELD
  BOOKED
  AGREEMENT_SIGNED
  REGISTERED
  POSSESSION
  BLOCKED // management / legal / mortgage — not sellable
}

enum HoldReleaseReason {
