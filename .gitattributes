# A shell script with CRLF line endings fails on the Linux build machines
# ("set: illegal option -"), and git on Windows would otherwise convert it.
*.sh text eol=lf

# pnpm applies these to node_modules; a CRLF copy from a Windows checkout must not
# be what it reads (patches/next@15.5.25.patch, see apps/web/test/react-ping-patch.test.ts).
patches/*.patch text eol=lf
